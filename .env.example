# ============================================================================
# VizhaVibe environment configuration
# Copy this file to `.env` and fill in values. Never commit real secrets.
# The demo experience works with NO credentials — all keys below are optional
# except DATABASE_URL (which defaults to a local SQLite file for zero-config).
# ============================================================================

# ---- Database --------------------------------------------------------------
# Default: local SQLite file (zero-config demo).
# For PostgreSQL, change the Prisma datasource provider to "postgresql" in
# prisma/schema.prisma and use a URL like:
#   postgresql://user:password@localhost:5432/vizhavibe?schema=public
DATABASE_URL="file:./dev.db"

# ---- Public app URL --------------------------------------------------------
# Used for absolute links and share URLs. No trailing slash.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---- Google Places (venue discovery) --------------------------------------
# Server-side key for the Google Places API (New). Keep this on the server.
# Required to search LIVE venues (e.g. "Arunadu", "mahal", "wedding hall") in
# Madurai/Chennai/Bangalore. When empty, VizhaVibe shows authorized catalog
# records (if any) or clearly-labeled sample data — never live data silently.
#
# Setup: Google Cloud Console -> enable "Places API (New)" -> enable billing ->
# create an API key -> restrict it to the Places API. See README.
GOOGLE_PLACES_API_KEY=""

# ---- Admin (authorized venue catalog) --------------------------------------
# Shared secret required to create/update CatalogVenue records via
# POST /api/admin/catalog-venues (header: x-admin-token). Leave empty to
# DISABLE catalog writes entirely (read-only). Use a long random value.
ADMIN_TOKEN=""

# Optional public key for client-side Maps JS (map embeds / directions links).
# Restrict this key by HTTP referrer in the Google Cloud console.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# How many hours to cache a Places result before re-fetching (Google terms
# allow limited caching; see README "Venue attribution and data caveats").
PLACES_CACHE_HOURS="24"

# ---- AI provider (planning assistant) --------------------------------------
# Provider abstraction — set AI_PROVIDER to one of: "demo", "openai".
# "demo" (default when no key) returns deterministic, clearly-labeled output.
AI_PROVIDER="demo"

# OpenAI-compatible key (only read on the server). Leave empty for demo mode.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
# Optional custom base URL for OpenAI-compatible gateways.
OPENAI_BASE_URL="https://api.openai.com/v1"

# ---- Rate limiting ----------------------------------------------------------
# Simple per-IP limits for AI and search endpoints (requests per minute).
RATE_LIMIT_PER_MINUTE="30"

# ---- Demo / safety flags ----------------------------------------------------
# When "true", the UI shows configuration status banners.
NEXT_PUBLIC_SHOW_CONFIG_STATUS="true"

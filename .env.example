# ============================================================================
# VizhaVibe environment configuration
# Copy this file to `.env` and fill in values. Never commit real secrets.
# The demo experience works with NO credentials — all keys below are optional
# except DATABASE_URL (which defaults to a local SQLite file for zero-config).
# ============================================================================

# ---- Database --------------------------------------------------------------
# Default: local SQLite file (zero-config demo).
# For PostgreSQL, change the Prisma datasource provider to "postgresql" in
# prisma/schema.prisma and use a URL like:
#   postgresql://user:password@localhost:5432/vizhavibe?schema=public
DATABASE_URL="file:./dev.db"

# ---- Public app URL --------------------------------------------------------
# Used for absolute links and share URLs. No trailing slash.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---- Geoapify Places (venue discovery) ------------------------------------
# Server-side key for the Geoapify Places API. Keep this on the server (never
# exposed to the browser). Required to search LIVE venues (e.g. "Arunadu",
# "mahal", "wedding hall") near a location or in Madurai/Chennai/Bangalore.
# When empty, VizhaVibe shows authorized catalog records (if any) or clearly
# labeled sample data — never live data silently.
#
# Setup: register at https://myprojects.geoapify.com (free, no card) -> create
# a project -> copy the auto-generated API key. Free tier = 3000 requests/day.
# Optionally restrict the key by IP/referrer in the Geoapify dashboard.
GEOAPIFY_API_KEY=""

# ---- Admin (authorized venue catalog) --------------------------------------
# Shared secret required to create/update CatalogVenue records via
# POST /api/admin/catalog-venues (header: x-admin-token). Leave empty to
# DISABLE catalog writes entirely (read-only). Use a long random value.
ADMIN_TOKEN=""

# ---- Authentication --------------------------------------------------------
# Secret used to sign session cookies and hash reset tokens. Use a long random
# value in production (e.g. `openssl rand -hex 32`). Never commit a real value.
AUTH_SECRET=""

# Initial ADMIN account, created by the seed script (prisma/seed.ts).
# Public signup can NEVER create an admin — only this seed can.
ADMIN_INITIAL_EMAIL=""
ADMIN_INITIAL_PASSWORD=""

# Email provider for password-reset links (optional). When unset, the reset
# link is logged server-side only (dev). Never expose these in the client.
EMAIL_PROVIDER_API_KEY=""
EMAIL_FROM="VizhaVibe <no-reply@vizhavibe.local>"

# ---- Google sign-in (Firebase Authentication) ------------------------------
# "Continue with Google" is enabled only when these are filled in. These
# NEXT_PUBLIC_* values are the Firebase WEB app config — they are NOT secrets
# (the browser needs them). Security is enforced by Firebase and by our own
# server-side ID-token verification (src/lib/firebaseVerify.ts).
#
# Setup:
#   1. console.firebase.google.com -> create/select a project.
#   2. Authentication -> Sign-in method -> enable "Google".
#   3. Authentication -> Settings -> Authorized domains -> add "localhost"
#      (and your production domain).
#   4. Project settings -> General -> Your apps -> add a Web app -> copy the
#      config values below.
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""

# How many hours to cache a Places result before re-fetching.
PLACES_CACHE_HOURS="24"

# ---- AI provider (planning assistant) --------------------------------------
# AI suggestions + chat require a configured live provider. When unset, those
# features return a clear setup message instead of fabricated output (there is
# NO demo mode). Set AI_PROVIDER="openai" and provide OPENAI_API_KEY to enable.
#
# Render: add these in the service's Environment settings (never commit real
# keys; never expose them to the browser — they are read only on the server).
AI_PROVIDER="openai"

# OpenAI-compatible key (server-only). Leave empty to disable AI features.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
# Optional custom base URL for OpenAI-compatible gateways.
OPENAI_BASE_URL="https://api.openai.com/v1"

# ---- Rate limiting ----------------------------------------------------------
# Simple per-IP limits for AI and search endpoints (requests per minute).
RATE_LIMIT_PER_MINUTE="30"

# ---- Demo / safety flags ----------------------------------------------------
# When "true", the UI shows configuration status banners.
NEXT_PUBLIC_SHOW_CONFIG_STATUS="true"
